# Set ONE of these to enable real LLM-powered classification/extraction.
# If neither is set, the agent falls back to a deterministic offline mock
# LLM (see agent/llm.py) so the whole pipeline still runs end-to-end for
# local testing/demoing without any API key.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Which model to use if ANTHROPIC_API_KEY is set
ANTHROPIC_MODEL=claude-sonnet-5

# Which model to use if OPENAI_API_KEY is set instead
OPENAI_MODEL=gpt-4o-mini

# Transport used to reach the MCP server: "stdio" (agent spawns the server
# itself as a subprocess) or "sse" (agent connects over HTTP to a
# separately-running MCP server, e.g. the mcp-server container in
# docker-compose).
MCP_TRANSPORT=stdio
MCP_SERVER_CMD=python
MCP_SERVER_ARGS=mcp_server/server.py
MCP_SERVER_URL=http://localhost:8765/sse

# SQLite paths (shared across containers via the ./data volume)
CATALOG_DB_PATH=data/catalog.db
STORE_DB_PATH=data/store.db
CHECKPOINT_DB_PATH=data/checkpoints.sqlite

# Confidence threshold above which a clean invoice is auto-approved
AUTO_APPROVE_CONFIDENCE=0.85

# Base URL the Streamlit app / n8n use to reach the FastAPI agent service
AGENT_API_URL=http://localhost:8000
