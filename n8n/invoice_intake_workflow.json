{
  "name": "Invoice Intake Orchestration",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "invoice-intake",
        "responseMode": "responseNode",
        "options": {}
      },
      "id": "1a1b1c1d-0001-4000-8000-000000000001",
